<!doctype html>
<html lang="en">
<head>
  <title>More Moji: Authorize</title>
  <%= partial 'public/partials/_head.html.erb' %>
  <script src="<%= h asset_path('/scripts/authorize.js') %>"></script>
</head>
<body class="site-page">
  <%= partial 'public/partials/_navigation.html.erb' %>
  <main id="main" class="page-container transaction-page">
    <img class="transaction-logo" src="<%= h asset_path('/img/icon.png') %>" width="88" height="88" alt="">
    <h1>Authorize your Slack profile</h1>
    <p>Let Moji add a little personality to your status.</p>
    <p id="messages" role="status" aria-live="polite"></p>
    <p>Use the <strong>Allow Moji</strong> link supplied by the bot. <a href="/help.html">Get help</a> if you need a hand.</p>
  </main>
  <%= partial 'public/partials/_footer.html.erb' %>
</body>
</html>
