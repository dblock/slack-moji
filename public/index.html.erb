<!doctype html>
<html lang="en">
<head>
  <title>More Moji: More Emoji in Slack</title>
  <meta name="description" content="Give your Slack status a little personality. Add emoji reactions to messages, too.">
  <meta name="slack-app-id" content="AFEH9PVM3">
  <%= partial 'public/partials/_head.html.erb' %>
  <script src="<%= h asset_path('/scripts/register.js') %>"></script>
</head>
<body class="site-page">
  <%= partial 'public/partials/_navigation.html.erb' %>
  <main id="main">
    <div id="homepage">
      <section class="hero page-container" aria-labelledby="hero-title">
        <img class="hero-icon" src="<%= h asset_path('/img/icon.png') %>" width="88" height="88" alt="">
        <h1 id="hero-title">More emoji.</h1>
        <p class="hero-description">Give your Slack status a little personality.<br>Add emoji reactions to messages, too.</p>
        <div class="hero-actions">
          <%= partial 'public/partials/_install_button.html.erb' %>
          <a href="#how-it-works">See how it works</a>
        </div>
        <p class="trial-note">Free for two weeks. Then $9.99 per team / year.</p>
      </section>
      <section class="feature-section" id="how-it-works" aria-labelledby="status-title">
        <div class="page-container feature-layout">
          <div class="feature-copy">
            <h2 id="status-title">Mix up your status</h2>
            <p>Run <code>/moji me</code>, authorize your profile, and choose <strong>Yes Emoji</strong>. Moji pairs a random emoji with words of wisdom.</p>
            <p>Want a break? Choose <strong>No Emoji</strong> to turn it off.</p>
          </div>
          <figure class="feature-preview">
            <img src="<%= h asset_path('/img/demo.png') %>" width="1290" height="862" alt="Moji authorizing a Slack profile and offering Yes Emoji and No Emoji controls">
          </figure>
        </div>
      </section>
      <section class="feature-section" aria-labelledby="reactions-title">
        <div class="page-container feature-layout">
          <div class="feature-copy">
            <h2 id="reactions-title">Say it with emoji</h2>
            <p>Open a message's actions and choose <strong>Emojify</strong>. Moji adds emoji reactions that match the words in the message.</p>
          </div>
          <figure class="feature-preview">
            <img src="<%= h asset_path('/img/emojify.gif') %>" width="788" height="568" alt="Using Emojify to add relevant emoji reactions to a Slack message" loading="lazy">
          </figure>
        </div>
      </section>
      <section class="pricing-section page-container" id="pricing" aria-label="Pricing">
        <div>
          <p>Try More Moji free for two weeks, without a credit card. Then subscribe your Slack team for $9.99 a year, automatically renewed.</p>
          <p><a href="/help.html#support">Questions? Get in touch.</a></p>
        </div>
        <div class="pricing-action">
          <p class="eyebrow">Simple pricing</p>
          <p class="price"><strong>$9.99</strong><span>per team / year</span></p>
          <%= partial 'public/partials/_install_button.html.erb' %>
        </div>
      </section>
    </div>
    <section id="register" class="page-container transaction-page" style="display: none;" aria-labelledby="register-title">
      <h1 id="register-title">Connect your Slack team</h1>
      <p id="messages" role="status" aria-live="polite">Working, please wait ...</p>
      <p><a href="/help.html">Get help</a> or <a href="/">return to More Moji</a>.</p>
    </section>
  </main>
  <%= partial 'public/partials/_footer.html.erb' %>
</body>
</html>
